  "issues": {
    "fritz_fehlt": {
      "title": "Heimnetz: FRITZ!Box Tools missing",
      "description": "The Heimnetz integration takes its access from FRITZ!Box Tools, whose entry was removed. Set up FRITZ!Box Tools again and re-add Heimnetz."
    },
    "anmeldung": {
      "title": "Heimnetz: FRITZ!Box login rejected",
      "description": "The FRITZ!Box rejects the credentials from FRITZ!Box Tools. Re-authenticate FRITZ!Box Tools; this notice then clears itself."
    },
    "alt_aktiv": {
      "title": "Heimnetz: old integration “Netzwerk” still active",
      "description": "Heimnetz replaces the integration “Netzwerk” and only starts once its entry is disabled (Settings → Devices & services → Netzwerk → ⋮ → Disable). Then reload Heimnetz; measurements, journal, settings and tickets are taken over."
    },
    "recorder_fehlt": {
      "title": "Heimnetz: recorder not loaded",
      "description": "Without the Home Assistant recorder, Heimnetz lacks history, usage per day and the snapshot per measurement taken from history. The recorder is the default (`default_config:` or `recorder:` in `configuration.yaml`). Then restart Home Assistant; this notice goes away by itself the next time Heimnetz loads."
    }
  },
