{
  "name": "heimnetz-panel",
  "private": true,
  "description": "Seite „Heimnetz“: Quellen unter src/, gebaut mit esbuild zu heimnetz-panel.js. Nur zum Bauen und Testen, wird nicht ausgeliefert.",
  "type": "module",
  "scripts": {
    "bauen": "node bauen.mjs",
